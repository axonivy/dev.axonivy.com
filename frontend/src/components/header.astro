---
import Navbar from "@/components/navbar";
import AxonIvyLogo from "@/assets/axonivy-logo-2021-rgb.svg";
import AxonIvyLogoDark from "@/assets/axonivy-logo-2021-rgb-neg.svg";
import { buttonVariants } from "@/components/ui/button";
import { ModeToggle } from "./ui/mode-toggle";
---

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>

<div class="fixed top-0 z-50 w-full border-b border-n100 bg-background">
  <div class="relative w-full mx-auto md:max-w-6xl py-4 px-4">
    <div class="flex flex-row justify-between items-center w-full gap-4">
      <a href="/">
        <AxonIvyLogo width={160} height={40} class="dark:hidden" />
        <AxonIvyLogoDark width={160} height={40} class="hidden dark:block" />
      </a>
      <Navbar type="header" client:load />
      <div class="hidden gap-2 md:flex">
        <ModeToggle client:load />
        <a href="/news" class={buttonVariants({ variant: "accent" })}>News</a>
        <a href="/download" class={buttonVariants({ variant: "default" })}
          >Download</a
        >
      </div>
    </div>
  </div>
</div>
