---
import Navbar from "@/components/navbar";
import AxonIvyLogo from "@/assets/axonivy-logo-2021-rgb.svg";
import AxonIvyLogoDark from "@/assets/axonivy-logo-2021-rgb-neg.svg";
import { buttonVariants } from "@/components/ui/button";
import { ModeToggle } from "./ui/mode-toggle";
---

<script is:inline>
  (() => {
    const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");

    const applyTheme = (theme) => {
      document.documentElement.classList.toggle("dark", theme === "dark");
    };

    const savedTheme = localStorage.getItem("theme");

    if (savedTheme === "dark") {
      applyTheme("dark");
    } else if (savedTheme === "light") {
      applyTheme("light");
    } else {
      applyTheme(mediaQuery.matches ? "dark" : "light");
    }

    mediaQuery.addEventListener("change", (event) => {
      if (
        !localStorage.getItem("theme") ||
        localStorage.getItem("theme") === "system"
      ) {
        applyTheme(event.matches ? "dark" : "light");
      }
    });
  })();
</script>

<div class="border-n100 bg-background fixed top-0 z-50 w-full border-b">
  <div class="relative mx-auto w-full px-4 py-4 md:max-w-6xl">
    <div class="flex w-full flex-row items-center justify-between gap-4">
      <a href="/">
        <AxonIvyLogo width={160} height={40} class="dark:hidden" />
        <AxonIvyLogoDark width={160} height={40} class="hidden dark:block" />
      </a>
      <Navbar type="header" client:load />
      <div class="hidden gap-2 md:flex">
        <ModeToggle client:load />
        <a href="/news" class={buttonVariants({ variant: "accent" })}>News</a>
        <a href="/download" class={buttonVariants({ variant: "default" })}
          >Download</a
        >
      </div>
    </div>
  </div>
</div>
