---
import ThemeToggle from "./ui/ThemeToggle.tsx";
import MobileMenu from "./ui/MobileMenu.tsx";

const path = Astro.url.pathname;

const navLinks = [
  { href: "/doc", label: "Docs" },
  { href: "https://market.axonivy.com/", label: "Market", external: true },
  {
    href: "https://community.axonivy.com/",
    label: "Community",
    external: true,
  },
  {
    href: "https://developer.axonivy.com/tutorial/",
    label: "Tutorial",
    external: true,
  },
  { href: "/team", label: "Team" },
];
---

<header class="sticky top-0 z-50 bg-(--background) border-b border-(--n200)">
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-5 px-6 py-3"
  >
    <!-- Logo -->
    <a href="/" class="inline-flex items-center" aria-label="Axon Ivy Home">
      <img
        src="/logo/axonivy-logo-black.svg"
        alt="Axon Ivy"
        loading="eager"
        width="160"
        height="37"
        class="theme-logo-light h-auto max-w-full"
      />
      <img
        src="/logo/axonivy-logo.svg"
        alt="Axon Ivy"
        loading="eager"
        width="160"
        height="37"
        class="theme-logo-dark h-auto max-w-full"
      />
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Main navigation">
      {
        navLinks.map((link) => {
          const active = !link.external && path === link.href;
          return (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer noopener" : undefined}
              aria-current={active ? "page" : undefined}
              class:list={[
                "text-sm font-medium transition-colors hover:text-(--body)",
                active ? "text-(--body)" : "text-(--n800)",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
    <div class="flex items-center gap-2">
      <a href="/news" class="btn-secondary hidden text-sm sm:inline-flex"
        >News</a
      >
      <a href="/download" class="btn-primary hidden text-sm sm:inline-flex"
        >Download</a
      >
      <ThemeToggle client:load />
      <MobileMenu links={navLinks} currentPath={path} client:load />
    </div>
  </div>
</header>
