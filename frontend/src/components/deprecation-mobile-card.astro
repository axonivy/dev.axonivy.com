---
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { IconExternalLink } from "@tabler/icons-astro";

interface Props {
  item: {
    name: string;
    nameHref?: string;
    released: string;
    deprecated: string;
    removed?: string;
    successor?: string;
    successorHref?: string;
  };
}

const { item } = Astro.props;
---

<Card>
  <CardHeader className="flex flex-row gap-3">
    <CardTitle className="flex w-full items-center justify-between gap-2">
      <span class="max-w-4/5">{item.name}</span>
      <a href={item.nameHref} class="shrink-0">
        <IconExternalLink class="h-4 w-4 shrink-0 text-primary" />
      </a>
    </CardTitle>
  </CardHeader>
  <CardContent>
    <div class="flex flex-col gap-2">
      <div class="flex w-full flex-row items-start justify-between gap-2">
        <p class="text-n800">Introduced in:</p>
        <p>{item.released}</p>
      </div>
      <div class="flex w-full flex-row items-start justify-between gap-2">
        <p class="text-n800">Deprecated in:</p>
        <p>{item.deprecated}</p>
      </div>
      <div class="flex w-full flex-row items-start justify-between gap-2">
        <p class="text-n800">Removed in:</p>
        <p>{item.removed}</p>
      </div>
      <div class="flex w-full flex-row items-start justify-between gap-2">
        <p class="text-n800">Successor:</p>
        <a href={item.successorHref} class="text-right text-primary underline">
          {item.successor}
        </a>
      </div>
    </div>
  </CardContent>
</Card>
