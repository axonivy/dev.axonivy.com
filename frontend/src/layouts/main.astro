---
import Header from "@/components/header.astro";
import Footer from "@/components/footer.astro";
import "@/styles/global.css";
import { Font } from "astro:assets";

type LinkedDescription = {
  before: string;
  link: {
    href: string;
    label: string;
  };
  after: string;
};

interface Props {
  title?: string;
  description?: string | LinkedDescription;
  center?: boolean;
}

const { title, description, center } = Astro.props;
---

<html lang="en">
  <head>
    <Font cssVariable="--font-inter" preload />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Axon Ivy Developer</title>
  </head>
  <body>
    <header>
      <Header />
    </header>
    <div
      class:list={[
        "w-full mx-auto flex min-h-screen md:max-w-6xl flex-col px-4 pb-20 pt-32",
        title ? "relative isolate gap-12" : "gap-6",
        center ? "justify-center" : "",
      ]}
    >
      {
        title && (
          <>
            <div
              aria-hidden="true"
              class="absolute top-20 left-1/2 -z-10 size-106 -translate-x-1/2 rounded-full bg-primary/10 blur-3xl md:size-144 dark:hidden"
            />
            <div class="flex w-full flex-col items-center gap-8 pt-8 text-center leading-loose md:w-2/3 md:self-center md:pt-12">
              <h1 class="text-3xl font-semibold md:text-6xl">{title}</h1>
              {description && (
                <p class="whitespace-pre-line text-base text-n900 md:text-xl">
                  {typeof description === "string" ? (
                    description
                  ) : (
                    <>
                      {description.before}
                      <a
                        href={description.link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline underline-offset-4 hover:text-primary"
                      >
                        {description.link.label}
                      </a>
                      {description.after}
                    </>
                  )}
                </p>
              )}
            </div>
          </>
        )
      }
      <slot />
    </div>
    <footer>
      <Footer />
    </footer>
  </body>
</html>
