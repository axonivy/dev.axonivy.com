---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "The Axon Ivy developer website." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <div class="flex min-h-screen flex-col">
      <Header />

      <main class="mx-auto w-full max-w-6xl flex-1 py-10 lg:py-14">
        <slot />
      </main>

      <footer class="border-t border-(--n200) py-10 flex flex-col gap-8">
        <div
          class="mx-auto flex flex-row w-full max-w-6xl items-center justify-between"
        >
          <a
            href="https://www.axonivy.com"
            target="_blank"
            rel="noreferrer noopener"
          >
            <img
              src="https://www.axonivy.com/hubfs/core/brand/axonivy-logo-black.svg"
              alt="Axon Ivy Logo."
              loading="lazy"
              width="150"
              class="h-auto max-w-full"
            />
          </a>
          <div>Navigation</div>
        </div>
        <div
          class="mx-auto flex flex-row w-full max-w-6xl items-center justify-between gap-5"
        >
          <div>
            <p>
              Get the latest stable <a
                href="/download"
                class="text-(--p300) underline">Long Term Support</a
              > version of the
            </p>
            <p>
              Axon Ivy Platform - or download the <a
                href="/download"
                class="text-(--p300) underline">Leading Edge</a
              > version
            </p>
          </div>
        </div>
        <div
          class="mx-auto flex flex-row w-full max-w-6xl items-center justify-between"
        >
          <a
            href="/download"
            class="inline-flex items-center bg-(--p300) px-4 py-2 text-(--background) rounded-(--r3) hover:bg-(--p500) transition"
            >Download</a
          >
          <a href="https://www.axonivy.com" class="text-(--p300) underline"
            >www.axonivy.com</a
          >
        </div>
        <div
          class="mx-auto py-12 border-t border-(--n200) flex flex-row w-full max-w-6xl items-center justify-between"
        >
          <div class="flex flex-row items-center gap-5">
            <a
              href="https://www.axonivy.com"
              target="_blank"
              rel="noreferrer noopener"
              class="hover:underline"
            >
              © 2024 Axon Ivy Inc.
            </a>
            <a
              href="https://www.axonivy.com/privacy-policy"
              target="_blank"
              rel="noreferrer noopener"
              class="hover:underline"
            >
              Privacy Policy
            </a>
            <a
              href="https://www.axonivy.com/legal-notice"
              target="_blank"
              rel="noreferrer noopener"
              class="hover:underline"
            >
              Terms of Service
            </a>
          </div>
          <div class="flex flex-row items-center">
            <a
              href="https://www.linkedin.com/company/axonivy/"
              target="_blank"
              rel="noreferrer noopener"
              aria-label="LinkedIn"
              class="inline-flex h-10 w-10 items-center justify-center"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-5 w-5 fill-(--body)"
                aria-hidden="true"
              >
                <path
                  d="M4.98 3.5C4.98 4.88 3.86 6 2.48 6A2.5 2.5 0 0 1 0 3.5 2.5 2.5 0 0 1 2.48 1 2.5 2.5 0 0 1 4.98 3.5ZM.5 8h4v15h-4V8Zm7 0h3.83v2.05h.06c.53-1 1.84-2.05 3.79-2.05C19.2 8 21 10.13 21 14.06V23h-4v-7.82c0-1.87-.03-4.27-2.6-4.27-2.6 0-3 2.03-3 4.14V23h-4V8Z"
                ></path>
              </svg>
            </a>
            <a
              href="https://hub.docker.com/u/axonivy"
              target="_blank"
              rel="noreferrer noopener"
              aria-label="Docker"
              class="inline-flex h-10 w-10 items-center justify-center"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-5 w-5 fill-(--body)"
                aria-hidden="true"
              >
                <path
                  d="M10.7 10.3H8.8V8.4h1.9v1.9Zm2.4 0h-1.9V8.4h1.9v1.9Zm-4.8 0H6.4V8.4h1.9v1.9Zm2.4 0H8.8V6.5h1.9v3.8Zm2.4 0h-1.9V6.5h1.9v3.8Zm2.4 0h-1.9V6.5h1.9v3.8Zm2.8 1.1c-.2-.1-1-.3-1.6-.2 0-.1 0-.2.1-.3.2-.9-.4-2.7-2.3-2.7-.2 0-.3 0-.5.1-.1 1.4.2 2.4 1 3-.4.2-.9.3-1.5.3H3.6c0 3.6 2.6 6.1 7 6.1 3.8 0 6.6-1.7 8-4.9 1 .1 2.5-.2 3.3-1.9-.8-.4-1.5-.5-1.7-.4Z"
                ></path>
              </svg>
            </a>
            <a
              href="https://github.com/axonivy"
              target="_blank"
              rel="noreferrer noopener"
              aria-label="GitHub"
              class="inline-flex h-10 w-10 items-center justify-center"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-5 w-5 fill-(--body)"
                aria-hidden="true"
              >
                <path
                  d="M12 1.5A10.5 10.5 0 0 0 8.68 22c.53.1.72-.23.72-.5v-1.95c-2.95.64-3.57-1.42-3.57-1.42-.49-1.23-1.18-1.56-1.18-1.56-.96-.66.07-.65.07-.65 1.06.08 1.62 1.09 1.62 1.09.94 1.61 2.47 1.15 3.08.88.1-.68.37-1.15.67-1.41-2.36-.27-4.85-1.18-4.85-5.26 0-1.16.41-2.11 1.09-2.85-.11-.27-.47-1.37.1-2.85 0 0 .89-.29 2.9 1.09a10 10 0 0 1 5.28 0c2.01-1.38 2.9-1.09 2.9-1.09.57 1.48.21 2.58.1 2.85.68.74 1.09 1.69 1.09 2.85 0 4.09-2.5 4.98-4.87 5.25.38.33.72.97.72 1.95v2.89c0 .28.19.61.73.5A10.5 10.5 0 0 0 12 1.5Z"
                ></path>
              </svg>
            </a>
            <a
              href="https://www.youtube.com/@AxonIvy"
              target="_blank"
              rel="noreferrer noopener"
              aria-label="YouTube"
              class="inline-flex h-10 w-10 items-center justify-center"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-5 w-5 fill-(--body)"
                aria-hidden="true"
              >
                <path
                  d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
