---
import PageLayout from "../layouts/PageLayout.astro";
import DocVersionCard from "../components/doc/DocVersionCard.tsx";
import { getDocVersions } from "../lib/api.ts";

const docVersions = await getDocVersions();
---

<PageLayout
  title="Documentation | Axon Ivy"
  pageTitle="Documentation"
  pageDescription="Find all information about the Axon Ivy Platform in our documents."
  glowColor="--red-bg"
>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 auto-rows-fr mb-10">
    <div class="lg:col-span-2 h-full">
      <DocVersionCard
        client:load
        title="LTS - Long Term Support"
        description="Stable versions with long-term support."
        versions={docVersions.lts}
        main={true}
      />
    </div>

    <div class="h-full">
      <DocVersionCard
        client:load
        title="LE - Leading Edge"
        description="Latest features with leading edge release."
        versions={docVersions.le}
      />
    </div>

    <div class="h-full">
      <DocVersionCard
        client:load
        title="Development Build"
        description="Latest development version."
        versions={docVersions.dev}
        showNews={false}
      />
    </div>
  </div>

  <div
    class="rounded-2xl bg-(--n25) border border-(--n200) p-6 flex flex-col lg:flex-row lg:justify-between lg:items-center gap-6"
  >
    <div class="flex gap-4 items-center">
      <div
        class="shrink-0 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-(--blue-bg)"
      >
        <div
          aria-hidden="true"
          class="h-8 w-8 block"
          style={`background-color: var(--blue); mask: url('/icons/book-close-2.svg') no-repeat center / contain; -webkit-mask: url('/icons/book-close-2.svg') no-repeat center / contain;`}
        >
        </div>
      </div>
      <div>
        <h3 class="text-lg font-bold text-(--body)">
          Want to see which features have been removed?
        </h3>
        <p class="text-sm text-(--n800)">
          Learn more about the features and products that have been deprecated
          or removed recently.
        </p>
      </div>
    </div>
    <a
      href="/deprecation"
      class="inline-flex items-center gap-2 text-(--body) border border-(--n200) rounded-lg px-4 py-2 text-sm whitespace-nowrap hover:bg-(--n50) transition"
    >
      View deprecation page <span aria-hidden="true">→</span>
    </a>
  </div>
</PageLayout>
