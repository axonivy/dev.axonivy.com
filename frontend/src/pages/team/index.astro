---

<Layout
  title="🇨🇭IvyTeam"
  description="IvyTeam is the core development team of the Axon Ivy Platform. The team is highly experienced in agile software development. Since the formation in the year 1993 the team is located in Zug in the heart of Switzerland."
>
  <div class="grid gap-6 md:grid-cols-3 grid-cols-1">
    {
      team.map((member) => {
        const Avatar = member.imgSrc;

        return (
          <Card className="flex flex-row items-center p-2 py-2 gap-2 ">
            <Avatar
              aria-label={`${member.name} avatar`}
              class="h-48 w-fit shrink-0 rounded-md"
            />
            <CardContent className="flex flex-col gap-2">
              <p class="font-semibold text-xl">{member.name}</p>
              <div class="text-sm text-n900">
                <p>{member.function}</p>
                <p>{member.education}</p>
              </div>
              <p class="text-sm">{member.slogan}</p>
            </CardContent>
          </Card>
        );
      })
    }
  </div>
</Layout>
