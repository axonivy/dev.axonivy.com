---
import { NewsTimeline } from "@/components/news/timeline";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Base, H3, H4, H5, H6 } from "@/components/ui/typography";
import { getNews } from "@/data/news/news";
import { newsTagLabel } from "@/components/news/news-tag-label";
import Layout from "@/layouts/main.astro";
import { cn } from "@/lib/utils";
import {
  IconArrowRight,
  IconArrowUpRight,
  IconCalendar,
  IconCircleCheck,
  IconStar,
} from "@tabler/icons-astro";
import { getLanguagePaths, localePath } from "@/translation/language";
import type { Lang } from "@/translation/ui";
import i18next from "@/translation/ui";

export const getStaticPaths = getLanguagePaths;

const lang = (Astro.currentLocale ?? "en") as Lang;
const t = i18next.getFixedT(lang);

const releases = getNews(lang).sort(
  (left, right) => right.release_date.getTime() - left.release_date.getTime(),
);
const timelineItems = releases
  .slice(1)
  .map((release) => ({
    id: release.id,
    versionTitle: release.version_title,
    slogan: release.slogan,
    tag: release.tag,
    releaseDate: release.release_date,
    overview: release.overview,
  }));

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(lang, {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
---

<Layout
  tabTitle={t("nav.news")}
  title={t("news.pageTitle")}
  description={t("news.description")}
>
  <div class="flex flex-col gap-12">
    <Card className="flex flex-col gap-8 p-6 md:flex-row">
      <div class="flex flex-1 flex-col gap-4">
        <CardHeader className="gap-4 px-0">
          <Badge
            variant={
              releases[0].tag === "Long Term Support"
                ? "green"
                : releases[0].tag === "Leading Edge"
                  ? "orange"
                  : "gray"
            }
            className="uppercase"
          >
            {newsTagLabel(releases[0].tag, t)}
          </Badge>
          <span class="flex items-center gap-2">
            <CardTitle>
              <H3 className="hidden md:flex">{releases[0].version_title}</H3>
              <H5 className="md:hidden">{releases[0].version_title}</H5>
            </CardTitle>
            <IconStar class="text-primary size-6 md:size-8" />
          </span>
          <CardDescription>
            <H6>{releases[0].slogan}</H6>
          </CardDescription>
        </CardHeader>
        <span class="text-n900 flex items-center gap-2">
          <IconCalendar class="size-4" />
          <Base>
            {t("news.released", { date: formatDate(releases[0].release_date) })}
          </Base>
        </span>
        <div class="flex flex-row gap-4">
          <a
            href={localePath(lang, `/news/${releases[0].id}`)}
            class={cn(
              buttonVariants({
                variant: "default",
                size: "lg",
                className: "group",
              }),
            )}
          >
            {t("news.readMore")}
            <IconArrowRight className="size-4 transition-transform duration-200 group-hover:translate-x-1" />
          </a>
          <a
            href={releases[0].migration_guide_url}
            target="_blank"
            rel="noopener noreferrer"
            class={buttonVariants({ variant: "outline", size: "lg" })}
          >
            {t("news.migrationGuide")}
            <IconArrowUpRight className="size-4" />
          </a>
        </div>
      </div>
      <CardContent className="flex flex-1 flex-col gap-4 px-0">
        <H4>{t("news.whatsNew", { version: releases[0].id })}</H4>
        <div class="flex flex-col gap-2">
          {releases[0].overview.map((fact: string) => (
            <span class="flex flex-row items-start gap-2">
              <IconCircleCheck class="text-primary mt-1 size-4 shrink-0" />
              <Base className="text-n900">{fact}</Base>
            </span>
          ))}
        </div>
      </CardContent>
    </Card>
    <div class="flex flex-col gap-8">
      <H3>{t("news.browseMore")}</H3>

      <NewsTimeline items={timelineItems} lang={lang} />
    </div>
  </div>
</Layout>
