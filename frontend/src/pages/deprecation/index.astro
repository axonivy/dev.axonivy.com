---
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import DeprecationMobileCard from "@/components/deprecation/deprecation-mobile-card.astro";
import DeprecationStep from "@/components/deprecation/deprecation-step.astro";
import Layout from "@/layouts/main.astro";
import deprecated from "@/data/deprecation";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { H4, H5 } from "@/components/ui/typography";

const deprecationSteps = [
  {
    description:
      "We document features that we will remove in the future on this page.",
  },
  {
    description:
      "We document Public API that we will remove in future versions in the source code as",
    code: "@Deprecated(forRemoval=true)",
  },
  {
    description:
      "We document features that we will remove on the Designer's UI in the Problem View as Warnings.",
  },
];

const currentVersion = 14;

const currentlyDeprecated = deprecated.filter(
  (item) => item.removed === undefined || item.removed > currentVersion,
);

const recentlyRemoved = deprecated.filter(
  (item) => item.removed !== undefined && item.removed <= currentVersion,
);

const deprecationSections = [
  {
    title: "Currently deprecated",
    description:
      "These features are deprecated and may be removed in future major releases:",
    items: currentlyDeprecated,
  },
  {
    title: "Recently removed",
    description: "These features have been removed in recent major releases:",
    items: recentlyRemoved,
  },
];
---

<Layout
  title="Deprecation & Removal"
  description={{
    before:
      "You should avoid using deprecated Public API and features. When migrating to a new version check for ",
    link: {
      href: "https://developer.axonivy.com/doc/12.0/en/public-api/deprecated-list.html",
      label: "deprecated Public API",
    },
    after: " and features and replace them with the successor API or feature.",
  }}
>
  <div class="flex flex-col gap-12">
    <Card>
      <CardHeader>
        <CardTitle>We deprecate and remove Features as follows:</CardTitle>
      </CardHeader>
      <CardContent className="flex flex-col gap-4 md:flex-row md:gap-6">
        {
          deprecationSteps.map((step, index) => (
            <DeprecationStep step={step} showSeparator={index > 0} />
          ))
        }
      </CardContent>
    </Card>
    {
      deprecationSections.map((section) => (
        <div class="flex flex-col gap-2">
          <H4>{section.title}</H4>
          <H5 className="font-normal text-n900">{section.description}</H5>
          <div class="overflow-hidden rounded-lg border border-border md:flex hidden">
            <Table>
              <TableHeader>
                <TableRow>
                  <TableHead className="w-[30%] whitespace-normal">
                    Feature
                  </TableHead>
                  <TableHead className="relative pr-4 before:absolute before:top-2 before:bottom-2 before:-left-1 before:w-px before:bg-border">
                    Introduced in
                  </TableHead>
                  <TableHead className="relative pr-4 before:absolute before:top-2 before:bottom-2 before:-left-1 before:w-px before:bg-border">
                    Deprecated in
                  </TableHead>
                  <TableHead className="relative pr-4 before:absolute before:top-2 before:bottom-2 before:-left-1 before:w-px before:bg-border">
                    Removed in
                  </TableHead>
                  <TableHead className="relative pr-4 before:absolute before:top-2 before:bottom-2 before:-left-1 before:w-px before:bg-border w-[30%] whitespace-normal">
                    Successor
                  </TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                {section.items.map((item) => (
                  <TableRow>
                    <TableCell className="font-medium whitespace-normal">
                      {item.nameHref ? (
                        <a href={item.nameHref} class="text-primary underline">
                          {item.name}
                        </a>
                      ) : (
                        item.name
                      )}
                    </TableCell>
                    <TableCell>{item.released}</TableCell>
                    <TableCell>{item.deprecated}</TableCell>
                    <TableCell>{item.removed}</TableCell>
                    <TableCell className="whitespace-normal">
                      {item.successorHref ? (
                        <a
                          href={item.successorHref}
                          class="text-primary underline"
                        >
                          {item.successor}
                        </a>
                      ) : (
                        item.successor
                      )}
                    </TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>
          </div>
          <div class="flex flex-col md:hidden gap-4">
            {section.items.map((item) => (
              <DeprecationMobileCard item={item} />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Layout>
