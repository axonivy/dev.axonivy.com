---
import PageLayout from "../layouts/PageLayout.astro";
import DownloadCard from "../components/download/DownloadCard.astro";
import VersionsTable from "../components/download/VersionsTable.tsx";
import { getDownloadVersions } from "../lib/api.ts";

const releases = getDownloadVersions().filter((r) => r.type !== "dev");
---

<PageLayout
  title="Download | Axon Ivy"
  pageTitle="Download Long Term Support 14.0"
  pageDescription="Download Axon Ivy and set up your environment"
  glowColor="--green-bg"
>
  {
    releases.map((release) => (
      <>
        <h2 class="mb-6 text-2xl font-bold text-(--body)">
          Download{" "}
          {release.type === "lts" ? "Long Term Support" : "Leading Edge"}{" "}
          {release.minorVersion}
        </h2>
        <div class="mb-16 grid gap-6 lg:grid-cols-2">
          <DownloadCard
            product="designer"
            versionLabel={
              release.type === "lts"
                ? `LTS ${release.majorVersion}`
                : `LE ${release.majorVersion}`
            }
            version={release.version}
            releaseDate={release.releaseDate}
            releaseType={release.type}
            artifacts={release.designerArtifacts}
            vsCodeUrl={release.vsCodeUrl}
            docsUrl={release.docsUrl}
            releaseNotesUrl={release.releaseNotesUrl}
          />
          <DownloadCard
            product="engine"
            versionLabel={
              release.type === "lts"
                ? `LTS ${release.majorVersion}`
                : `LE ${release.majorVersion}`
            }
            version={release.version}
            releaseDate={release.releaseDate}
            releaseType={release.type}
            artifacts={release.engineArtifacts}
            docsUrl={release.docsUrl}
            releaseNotesUrl={release.releaseNotesUrl}
          />
        </div>
      </>
    ))
  }

  <div class="mb-16">
    <VersionsTable
      devReleases={[]}
      archivesByMajor={{
        "14": [
          {
            version: "14.0.14",
            date: "Dec 2026",
            windowsUrl: "#",
            macosUrl: "#",
            linuxUrl: "#",
          },
          {
            version: "14.0.13",
            date: "Nov 2026",
            windowsUrl: "#",
            macosUrl: "#",
            linuxUrl: "#",
          },
        ],
        "13": [
          {
            version: "13.2.0",
            date: "Dec 2025",
            windowsUrl: "#",
            macosUrl: "#",
            linuxUrl: "#",
          },
        ],
      }}
      client:load
    />
  </div>
</PageLayout>
