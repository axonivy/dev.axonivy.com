---
import LegacyDocumentation, {
  legacyDocsVersions,
} from "@/components/documentation/legacy-documentation";
import Layout from "@/layouts/news.astro";
import { fetchLegacyDocData } from "@/lib/backend";

export async function getStaticPaths() {
  const perVersion = await Promise.all(
    legacyDocsVersions.map(async (version) => {
      const overview = await fetchLegacyDocData(version);
      const docPages = await Promise.all(
        overview.releaseDocuments.links.map(async (link) => {
          const path = link.url.slice(`/doc/${version}/`.length);
          return {
            params: { id: version, path },
            props: {
              legacyDocData: await fetchLegacyDocData(version, path),
              activeUrl: link.url,
            },
          };
        }),
      );
      return [
        {
          params: { id: version, path: undefined },
          props: { legacyDocData: overview, activeUrl: undefined },
        },
        ...docPages,
      ];
    }),
  );
  return perVersion.flat();
}

const { legacyDocData, activeUrl } = Astro.props;
---

<Layout tabTitle="Documentation">
  <LegacyDocumentation data={legacyDocData} activeUrl={activeUrl} client:load />
</Layout>
