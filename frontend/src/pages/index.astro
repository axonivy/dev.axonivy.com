---
import MainPageLayout from "../layouts/MainPageLayout.astro";

const quickLinks = [
  {
    title: "Download",
    description: "Download Axon Ivy and set up your environment.",
    href: "/download",
    bg: "bg-[#e2f6ed]",
    iconUrl: "/icons/download-bottom.svg",
    iconColor: "var(--green)",
  },
  {
    title: "News",
    description: "Read the latest updates and releases.",
    href: "/news",
    bg: "bg-[#fff1cf]",
    iconUrl: "/icons/newspaper-fold.svg",
    iconColor: "var(--yellow)",
  },
  {
    title: "Documentation",
    description: "Guides, API reference and tutorials.",
    href: "/doc",
    bg: "bg-[#ffd8dd]",
    iconUrl: "/icons/book-close-2.svg",
    iconColor: "var(--red)",
  },
  {
    title: "Marketplace",
    description: "Extend your projects with apps and connectors.",
    href: "https://market.axonivy.com/",
    external: true,
    bg: "bg-[#ece1ff]",
    iconUrl: "/icons/shop.svg",
    iconColor: "var(--purple)",
  },
  {
    title: "Community",
    description: "Join the community and get support.",
    href: "https://community.axonivy.com/",
    external: true,
    bg: "bg-[#dceaff]",
    iconUrl: "/icons/multiple-actions-chat.svg",
    iconColor: "var(--blue)",
  },
];
---

<MainPageLayout title="Axon Ivy Developer Website">
  <section
    class="relative isolate mx-auto min-h-full overflow-hidden px-10 pt-10"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-[35%] -z-10 h-132 w-132 -translate-x-1/2 -translate-y-1/2 rounded-full bg-(--blue-bg) opacity-35 blur-3xl"
    >
    </div>
    <h1
      class="relative mx-auto text-center max-w-4xl text-4xl font-bold leading-tight tracking-tight text-(--body) md:text-6xl"
    >
      Build and automate<br />business process faster<br />with Axon Ivy
    </h1>
    <p
      class="relative mx-auto text-center mt-8 max-w-3xl text-xl leading-relaxed text-(--n900)"
    >
      The open BPM platform to build enterprise-grade applications.<br
        class="hidden md:block"
      />
      Model. Automate. Integrate. All in one.
    </p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 min-[73rem]:grid-cols-5">
      {
        quickLinks.map((card) => (
          <a
            href={card.href}
            target={card.external ? "_blank" : undefined}
            rel={card.external ? "noreferrer noopener" : undefined}
            class="group rounded-3xl  bg-(--background) p-6 shadow-[0_16px_40px_rgba(58,83,116,0.1)] transition hover:-translate-y-1 hover:shadow-[0_22px_45px_rgba(58,83,116,0.18)]"
          >
            <div
              class:list={[
                "inline-flex h-16 w-16 items-center justify-center rounded-2xl",
                card.bg,
              ]}
            >
              <span
                aria-hidden="true"
                class="h-9 w-9"
                style={`background-color: ${card.iconColor}; mask: url('${card.iconUrl}') no-repeat center / contain; -webkit-mask: url('${card.iconUrl}') no-repeat center / contain;`}
              />
            </div>
            <h2 class="mt-5 text-[25px] font-bold leading-none tracking-tight text-(--body)">
              {card.title}
            </h2>
            <p class="mt-3 text-l leading-relaxed text-(--n800) max-w-40">
              {card.description}
            </p>
            <div class="mt-5 text-3xl font-semibold text-(--body)">→</div>
          </a>
        ))
      }
    </div>

    <div class="my-13 text-center text-lg">
      <p>
        Open source <span class="mx-2">•</span> Enterprise ready <span
          class="mx-2">•</span
        >
        <a
          href="https://www.axonivy.com"
          target="_blank"
          rel="noreferrer noopener"
          class="underline text-(--p300)">www.axonivy.com</a
        >
      </p>
    </div>
  </section>
</MainPageLayout>
