---
import LandingLayout from "../layouts/LandingLayout.astro";
import QuickLinkCard from "../components/QuickLinkCard.astro";

const quickLinks = [
  {
    title: "Download",
    description: "Download Axon Ivy and set up your environment.",
    href: "/download",
    bg: "bg-(--green-bg)",
    iconUrl: "/icons/download-bottom.svg",
    iconColor: "var(--green)",
  },
  {
    title: "News",
    description: "Read the latest updates and releases.",
    href: "/news",
    bg: "bg-(--yellow-bg)",
    iconUrl: "/icons/newspaper-fold.svg",
    iconColor: "var(--yellow)",
  },
  {
    title: "Documentation",
    description: "Guides, API reference and tutorials.",
    href: "/doc",
    bg: "bg-(--red-bg)",
    iconUrl: "/icons/book-close-2.svg",
    iconColor: "var(--red)",
  },
  {
    title: "Marketplace",
    description: "Extend your projects with apps and connectors.",
    href: "https://market.axonivy.com/",
    external: true,
    bg: "bg-(--purple-bg)",
    iconUrl: "/icons/shop.svg",
    iconColor: "var(--purple)",
  },
  {
    title: "Community",
    description: "Join the community and get support.",
    href: "https://community.axonivy.com/",
    external: true,
    bg: "bg-(--blue-bg)",
    iconUrl: "/icons/multiple-actions-chat.svg",
    iconColor: "var(--blue)",
  },
];
---

<LandingLayout title="Build and automate business process faster with Axon Ivy">
  <section
    class="relative isolate mx-auto w-full overflow-hidden px-6 pt-20 pb-20 flex flex-1 flex-col justify-center"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-(--blue-bg) opacity-35 blur-3xl"
    >
    </div>
    <div class="mx-auto max-w-7xl">
      <h1
        class="text-center text-4xl font-bold leading-tight tracking-tight text-(--body) md:text-5xl"
      >
        Build and automate<br />business process faster<br />with Axon Ivy
      </h1>
      <p
        class="mt-8 text-center text-lg leading-relaxed text-(--n900) mx-auto max-w-2xl"
      >
        The open BPM platform to build enterprise-grade applications.<br
          class="hidden md:block"
        />
        Model. Automate. Integrate. All in one.
      </p>

      <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {
          quickLinks.map((card) => (
            <QuickLinkCard
              title={card.title}
              description={card.description}
              href={card.href}
              iconUrl={card.iconUrl}
              iconColor={card.iconColor}
              iconBg={card.bg}
              external={card.external}
            />
          ))
        }
      </div>

      <div class="mt-16 text-center text-base text-(--n800)">
        <p>
          Open source <span class="mx-2">•</span> Enterprise ready <span
            class="mx-2">•</span
          >
          <a
            href="https://www.axonivy.com"
            target="_blank"
            rel="noreferrer noopener"
            class="text-(--p300) underline"
          >
            www.axonivy.com
          </a>
        </p>
      </div>
    </div>
  </section>
</LandingLayout>
