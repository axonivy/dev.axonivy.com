---
import Layout from "@/layouts/main.astro";
import { IconArrowRight, IconPointFilled } from "@tabler/icons-astro";
import { buttonVariants } from "@/components/ui/button";
---

<Layout
  title="Build and automate business process faster with Axon Ivy"
  description={"The open BPM platform to build enterprise-grade applications.\nModel. Automate. Integrate. All in one."}
  center={true}
>
  <div class="flex flex-col items-center gap-12 leading-loose">
    <div class="w-full max-w-3xs flex flex-col gap-4 justify-center">
      <a
        href="/download"
        class={buttonVariants({
          variant: "default",
          size: "lg",
          class: "w-full",
        }) + " group"}
      >
        Get started
        <IconArrowRight
          class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
        />
      </a>
      <a
        href="/news"
        class={buttonVariants({ variant: "outline", size: "lg" })}
      >
        Latest News
      </a>
    </div>
    <div class="flex flex-row items-center gap-2 text-lg text-n900">
      <p>Open Source</p>
      <IconPointFilled class="h-3 w-3" />
      <p>Enterprise ready</p>
      <IconPointFilled class="h-3 w-3 hidden md:flex" />
      <a
        href="https://www.axonivy.com"
        class="text-primary underline hidden md:flex"
      >
        www.axonivy.com
      </a>
    </div>
  </div>
</Layout>
