---
import Layout from "@/layouts/main.astro";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import {
  IconArrowRight,
  IconBook,
  IconBuildingStore,
  IconDownload,
  IconNews,
  IconPointFilled,
  IconUsers,
} from "@tabler/icons-astro";
import { buttonVariants } from "@/components/ui/button";

const iconMap = {
  IconDownload,
  IconNews,
  IconBook,
  IconBuildingStore,
  IconUsers,
};

type CardIconName = keyof typeof iconMap;

type HomepageCard = {
  id: number;
  icon: CardIconName;
  title: string;
  description: string;
  href: string;
};

const cards: HomepageCard[] = [
  {
    id: 1,
    icon: "IconDownload",
    title: "Download",
    description: "Download Axon Ivy and set up your environment.",
    href: "/download",
  },
  {
    id: 2,
    icon: "IconNews",
    title: "News",
    description: "Read the latest updates and releases",
    href: "/news",
  },
  {
    id: 3,
    icon: "IconBook",
    title: "Documentation",
    description: "Guides, API, reference and tutorials.",
    href: "/docs",
  },
  {
    id: 4,
    icon: "IconBuildingStore",
    title: "Marketplace",
    description: "Extend your projects with apps and connectors.",
    href: "https://market.axonivy.com/",
  },
  {
    id: 5,
    icon: "IconUsers",
    title: "Community",
    description: "Join the community and get support.",
    href: "https://community.axonivy.com/",
  },
];
---

<Layout>
  <div
    class="relative isolate flex flex-col items-center gap-12 leading-loose md:py-12 py-4"
  >
    <div
      aria-hidden="true"
      class="absolute top-0 left-1/2 -z-10 size-106 -translate-x-1/2 rounded-full bg-primary/10 blur-3xl md:size-144"
    >
    </div>
    <div class="flex w-full md:w-2/3 flex-col items-center gap-8 text-center">
      <h1 class="text-3xl font-semibold md:text-6xl">
        Build and automate business process faster with Axon Ivy
      </h1>
      <p class="text-base md:text-xl text-n900">
        The open BPM platform to build enterprise-grade applications. <br />
        Model. Automate. Integrate. All in one.
      </p>
      <a
        href="/download"
        class={buttonVariants({
          variant: "default",
          size: "lg",
          class: "md:hidden w-full",
        })}
      >
        Download
      </a>
    </div>
    <div
      class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5"
    >
      {
        cards.map((card) => {
          const CardIcon = iconMap[card.icon];

          return (
            <a
              href={card.href}
              class="group block h-full rounded-xl focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-1"
            >
              <Card className="h-full w-full transition-shadow group-hover:shadow-md">
                <div class="flex items-center justify-between gap-4 px-4 md:hidden">
                  {CardIcon && <CardIcon class="size-8 shrink-0" />}
                  <div>
                    <CardTitle>{card.title}</CardTitle>
                    <CardDescription>{card.description}</CardDescription>
                  </div>
                  <IconArrowRight
                    class="size-6 shrink-0 stroke-2"
                    aria-hidden="true"
                  />
                </div>

                <div class="hidden h-full md:flex md:flex-col">
                  <CardHeader>
                    {CardIcon && <CardIcon class="mb-2 mt-2 size-8" />}
                    <CardTitle>{card.title}</CardTitle>
                    <CardDescription className="w-3/4">
                      {card.description}
                    </CardDescription>
                  </CardHeader>
                  <CardContent className="mt-auto">
                    <IconArrowRight
                      class="size-6 stroke-2"
                      aria-hidden="true"
                    />
                  </CardContent>
                </div>
              </Card>
            </a>
          );
        })
      }
    </div>
    <div class="flex flex-row items-center gap-2 text-lg text-n900">
      <p>Open Source</p>
      <IconPointFilled class="h-3 w-3" />
      <p>Enterprise ready</p>
      <IconPointFilled class="h-3 w-3 hidden md:flex" />
      <a
        href="https://www.axonivy.com"
        class="text-primary underline hidden md:flex"
      >
        www.axonivy.com
      </a>
    </div>
  </div>
</Layout>
