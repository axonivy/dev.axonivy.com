---
import Layout from "@/layouts/main.astro";
import { IconArrowRight, IconCheck, IconCopy } from "@tabler/icons-astro";
import { buttonVariants } from "@/components/ui/button";
import AxonIvySmall from "@/assets/axonivy-logo-small.svg";
import AxonIvySmallDark from "@/assets/axonivy-logo-small-dark.svg";
import { Image } from "astro:assets";
import Processflowbackground from "@/components/processflowbackground.astro";

const topSteps = [
  { type: "start" },
  { type: "task", label: "Enter Request" },
  { type: "task", label: "Verify Request" },
  { type: "task", label: "Check Stock" },
  { type: "gateway", branch: "Handle Backorder" },
  { type: "task", label: "Approve Request" },
  { type: "task", label: "Assign Supplier" },
  { type: "task", label: "Negotiate Price" },
  { type: "end" },
];

const bottomSteps = [
  { type: "start" },
  { type: "task", label: "Create Order" },
  { type: "task", label: "Confirm Order" },
  { type: "task", label: "Schedule Delivery" },
  { type: "gateway", branch: "Resolve Delay" },
  { type: "task", label: "Ship Goods" },
  { type: "task", label: "Track Shipment" },
  { type: "task", label: "Confirm Receipt" },
  { type: "end" },
];
---

<Layout
  title="Build and automate business processes faster with Axon Ivy"
  description={"The open BPM platform to build enterprise-grade applications.\nModel. Automate. Integrate. All in one."}
  center={true}
>
  <Processflowbackground slot="hero-background" class="absolute inset-0" />

  <div class="flex flex-col items-center gap-4 leading-loose">
    <div class="w-full flex max-w-3xs flex-col gap-4 justify-center">
      <a
        href="/download"
        class={buttonVariants({
          variant: "default",
          size: "lg",
          class: "w-full",
        }) + " group"}
      >
        Get started
        <IconArrowRight
          class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
        />
      </a>
      <a
        href="/news"
        class={buttonVariants({ variant: "outline", size: "lg" })}
      >
        Latest News
      </a>
    </div>
    <button
      type="button"
      data-copy-command="docker pull axonivy/axonivy-engine"
      aria-label="Copy Docker command"
      class="group relative flex max-w-full items-center justify-center gap-2 font-code text-code"
    >
      <Image
        src={AxonIvySmall}
        alt="Axon Ivy Small Logo"
        class="size-4 dark:hidden"
      />
      <Image
        src={AxonIvySmallDark}
        alt="Axon Ivy Small Dark Logo"
        class="size-4 hidden dark:block"
      />
      <span class="whitespace-nowrap">~ docker pull axonivy/axonivy-engine</span
      >
      <IconCopy
        data-copy-icon
        aria-hidden="true"
        class="absolute -right-6 size-4 opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
      />
      <IconCheck
        data-check-icon
        aria-hidden="true"
        class="absolute -right-6 hidden size-4 text-primary"
      />
    </button>
  </div>
</Layout>

<script is:inline>
  document.querySelectorAll("[data-copy-command]").forEach((commandButton) => {
    const copyIcon = commandButton.querySelector("[data-copy-icon]");
    const checkIcon = commandButton.querySelector("[data-check-icon]");

    const resetIcon = () => {
      copyIcon.classList.remove("hidden");
      checkIcon.classList.add("hidden");
    };

    commandButton.addEventListener("click", async () => {
      await navigator.clipboard.writeText(commandButton.dataset.copyCommand);
      copyIcon.classList.add("hidden");
      checkIcon.classList.remove("hidden");
    });

    commandButton.addEventListener("mouseleave", resetIcon);
  });
</script>
