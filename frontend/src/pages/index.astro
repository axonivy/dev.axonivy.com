---
import Layout from "@/layouts/main.astro";
import {
  IconArrowRight,
  IconCheck,
  IconCopy,
  IconInfoCircle,
} from "@tabler/icons-astro";
import { CURRENT_VERSION } from "@/data/global-variables";
import { buttonVariants } from "@/components/ui/button";
import Processflowbackground from "@/components/processflowbackground.astro";
---

<Layout
  title="Build and automate business processes with Axon Ivy"
  description={"The open BPM platform to build enterprise-grade applications.\nModel. Automate. Integrate. All in one."}
  left={true}
>
  <Processflowbackground
    slot="hero-background"
    class="absolute inset-0 blur-[1.5px]"
  />

  <div class="flex flex-col items-center gap-4 leading-loose md:items-start">
    <div class="flex max-w-3xs flex-row justify-center gap-4 md:justify-start">
      <a
        href="download"
        class={buttonVariants({ variant: "default", size: "lg" }) +
          " px-6 group"}
      >
        Get Started
        <IconArrowRight
          class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
        />
      </a>
      <a
        href="/news"
        class={buttonVariants({ variant: "outline", size: "lg" }) + " px-6"}
      >
        Latest News
      </a>
    </div>
    <div class="flex items-start gap-2 md:items-center">
      <a
        href="/download/installation/docker?downloadUrl=https%3A%2F%2Fhub.docker.com%2Fr%2Faxonivy%2Faxonivy-engine"
        aria-label="View Docker installation guide"
        title="View Docker installation guide"
        class="text-code hover:text-primary mt-1 shrink-0 transition-colors md:mt-0"
      >
        <IconInfoCircle aria-hidden="true" class="size-4" />
      </a>
      <button
        type="button"
        data-copy-command={`docker run -p 8080:8080 axonivy/axonivy-engine:${CURRENT_VERSION}`}
        aria-label="Copy Docker command"
        class="group font-code text-code relative flex max-w-full flex-row items-end justify-center gap-2"
      >
        <span class="min-w-0 text-center">
          ~ docker run -p 8080:8080 axonivy/axonivy-engine:{CURRENT_VERSION}
          <IconCheck
            data-check-icon
            aria-hidden="true"
            class="text-primary ml-1 hidden size-4 align-middle md:absolute md:top-1/2 md:-right-6 md:-translate-y-1/2"
          />
        </span>
        <IconCopy
          data-copy-icon
          aria-hidden="true"
          class="absolute top-1/2 -right-6 size-4 -translate-y-1/2 opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
        />
      </button>
    </div>
  </div>
</Layout>

<script is:inline>
  document.querySelectorAll("[data-copy-command]").forEach((commandButton) => {
    const copyIcon = commandButton.querySelector("[data-copy-icon]");
    const checkIcon = commandButton.querySelector("[data-check-icon]");

    const resetIcon = () => {
      copyIcon.classList.remove("hidden");
      checkIcon.classList.add("hidden");
      checkIcon.classList.remove("inline-block");
    };

    commandButton.addEventListener("click", async () => {
      await navigator.clipboard.writeText(commandButton.dataset.copyCommand);
      copyIcon.classList.add("hidden");
      checkIcon.classList.remove("hidden");
      checkIcon.classList.add("inline-block");
    });

    commandButton.addEventListener("mouseleave", resetIcon);
  });
</script>
