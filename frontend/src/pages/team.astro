---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Team | Axon Ivy">
  <section class="rounded-[30px] border border-[#e7edf5] bg-white p-8 shadow-[0_24px_80px_rgba(58,83,116,0.12)] lg:p-14">
    <h1 class="text-5xl font-extrabold tracking-tight text-[#202531]">Team</h1>
    <p class="mt-5 max-w-3xl text-2xl leading-relaxed text-[#677180]">
      Placeholder page. Team information and contact points will be published here.
    </p>
    <div class="mt-8 rounded-2xl border border-dashed border-[#ccd6e2] bg-[#f8fbff] p-6 text-lg text-[#7a8492]">
      Coming soon: contributor profiles and responsibilities.
    </div>
  </section>
</BaseLayout>