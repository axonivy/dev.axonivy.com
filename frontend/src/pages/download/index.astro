---
import type {
  ArchiveData,
  UiArchiveResponse,
} from "@/components/download/archive/archive";
import Archive from "@/components/download/archive/archive";
import type { UiDownloadResponse } from "@/components/download/download";
import Download from "@/components/download/download";
import { HelpBox } from "@/components/help-box";
import { H3, H5 } from "@/components/ui/typography";
import Layout from "@/layouts/main.astro";
import { fetchBackend, getVersions } from "@/lib/backend";
import {
  IconFileDescription,
  IconMessageChatbot,
  IconMessageCircle,
  IconMessageCircleQuestion,
} from "@tabler/icons-react";

const downloadData = await fetchBackend<UiDownloadResponse>("/ui/download");

function fetchArchive(version?: string) {
  return fetchBackend<UiArchiveResponse>(
    version ? `/ui/archive/${encodeURIComponent(version)}` : "/ui/archive",
  );
}

const overview = await fetchArchive();
const versionIds = Object.values(overview.categorizedVersions)
  .flat()
  .map((version) => version.id);
const releasesByVersion = Object.fromEntries(
  await Promise.all(
    versionIds.map(
      async (id) => [id, (await fetchArchive(id)).releaseInfos] as const,
    ),
  ),
);

const archiveData: ArchiveData = {
  categorizedVersions: overview.categorizedVersions,
  currentMajorVersion: overview.currentMajorVersion,
  releasesByVersion,
};

const { current } = await getVersions();
---

<Layout
  tabTitle="Download"
  title={`Download Long Term Support ${current}`}
  description={
    "Axon Ivy consists of two components: \nThe Designer to build your applications and the Engine to run them."
  }
>
  <div class="flex flex-col gap-24">
    <Download data={downloadData} client:load />

    <div
      id="archive"
      class="bg-n50 flex scroll-mt-24 flex-col gap-6 rounded-2xl p-4 md:p-10"
    >
      <div class="flex flex-col gap-4">
        <H3>Version and Download Options</H3>
        <H5 className="text-n900 font-normal">
          Explore some older versions and dev releases of the designer and
          engine.
        </H5>
      </div>
      <Archive data={archiveData} client:load />
    </div>
  </div>

  <HelpBox
    icon={IconMessageCircleQuestion}
    title="Need help?"
    links={[
      {
        icon: IconFileDescription,
        title: "Documentation",
        description: "Find guides and references.",
        href: "/doc",
        linkLabel: "Go to Docs",
      },
      {
        icon: IconMessageCircle,
        title: "Community",
        description: "Ask questions and get help.",
        href: "https://community.axonivy.com/",
        linkLabel: "Go to Community",
        external: true,
      },
      {
        icon: IconMessageChatbot,
        title: "Contact Support",
        description: "Need additional assistance?",
        href: "/support",
        linkLabel: "Contact us",
      },
    ]}
  />
</Layout>
