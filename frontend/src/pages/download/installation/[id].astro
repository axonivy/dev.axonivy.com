---
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@/components/ui/breadcrumb";
import InstallationScrollSpy from "@/components/download/installation/scrollspy";
import guides, { type InstallationGuide } from "@/data/installation-guides";
import Layout from "@/layouts/news.astro";

type GuideId = keyof typeof guides;

export function getStaticPaths() {
  const engineGuideIds = [
    "engine-windows",
    "engine-linux",
    "engine-mac",
  ] as const;

  const guidePaths = Object.entries(guides).map(([id, guide]) => ({
    params: { id },
    props: { guideId: id as GuideId, guide },
  }));
  const enginePaths = engineGuideIds.map((id) => ({
    params: { id },
    props: { guideId: id, guide: guides.engine },
  }));

  return [...guidePaths, ...enginePaths];
}

const { guideId, guide } = Astro.props as {
  guideId: GuideId;
  guide: InstallationGuide;
};

if (!guide) {
  return Astro.redirect("/download");
}
---

<Layout>
  <div class="flex flex-col">
    <div
      class="sticky top-32 z-20 bg-background py-2 before:absolute before:inset-x-0 before:-top-16 before:h-16 before:bg-background before:content-[''] pb-8"
    >
      <Breadcrumb className="px-3">
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink href="/">Home</BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbLink href="/download">Download</BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>{guide.title}</BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
    </div>

    <InstallationScrollSpy guideId={guideId} guide={guide} client:load />
  </div>
</Layout>
