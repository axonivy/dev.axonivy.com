---
import {
  Card,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { H4 } from "@/components/ui/typography";
import Layout from "@/layouts/main.astro";
import { HelpBox } from "@/components/help-box";
import { IconCircleCheck } from "@tabler/icons-astro";
import { IconHeadset, IconMail, IconTicket } from "@tabler/icons-react";

const supportInfo = [
  {
    title: "Product / Service",
    description: "Designer, Engine, REST Service, Web Service or Database",
  },
  {
    title: "Version you're using",
    description: "For example, version: 8.0.20",
  },
  { title: "Description", description: "Detailed description of your problem" },
  {
    title: "*Way to reproduce",
    description: "Detailed way how your bug or problem can be reproduced",
  },
  {
    title: "*Stacktrace / Log",
    description: "Share stacktraces as text or log files as attachments",
  },
  { title: "*Screenshots", description: "Share screenshots as attachments" },
  {
    title: "*Configuration",
    description: "Share your yaml configuration files as text or attachment",
  },
];
---

<Layout
  title="Support"
  description="Axon Ivy Support is commiting to provide high-quality, technical support for quick problem solving, training or consulting. This protects your Axon Ivy investment and lets all participants sleep well."
>
  <div class="flex flex-col gap-4">
    <H4>
      If you open a support ticket, please share the following information:{" "}
      <span class="font-normal">(*if available)</span>
    </H4>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {supportInfo.map((info, index) => (
        <Card
          className={
            index === supportInfo.length - 1 && supportInfo.length % 2 !== 0
              ? "md:col-span-2"
              : ""
          }
        >
          <CardHeader className="flex flex-row gap-4 w-full">
            <div class="text-primary mt-1">
              <IconCircleCheck class="size-4 shrink-0" />
            </div>
            <div>
              <CardTitle>{info.title}</CardTitle>
              <CardDescription>{info.description}</CardDescription>
            </div>
          </CardHeader>
        </Card>
      ))}
    </div>
  </div>
  <HelpBox
    icon={IconHeadset}
    tone="yellow"
    title="Need Support?"
    text="To get support please contact us"
    links={[
      {
        icon: IconTicket,
        title: "Create ticket",
        description: "Create a ticket in our help center",
        href: "https://support.axonivy.com/",
        linkLabel: "Help center",
        external: true,
      },
      {
        icon: IconMail,
        title: "Send us an email",
        description: "Let us know your support issue via email",
        href: "mailto:support@axonivy.com",
        linkLabel: "support@axonivy.com",
        arrow: false,
      },
    ]}
  />
</Layout>
