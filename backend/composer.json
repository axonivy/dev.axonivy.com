{
  "require": {
    "slim/slim": "*",
    "slim/psr7": "*",
    "php-di/php-di": "*",
    "middlewares/trailing-slash": "*",
    "guzzlehttp/guzzle": "*",
    "swagger-api/swagger-ui": "^5.33"
  },
  "require-dev": {
    "phpunit/phpunit": "*",
    "cyclonedx/cyclonedx-php-composer": "*"
  },
  "autoload": {
    "psr-4": {
      "app\\": "src/app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "test\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "cyclonedx/cyclonedx-php-composer": true
    }
  },
  "scripts": {
    "post-install-cmd": [
      "php copy-swagger.php"
    ],
    "post-update-cmd": [
      "php copy-swagger.php"
    ]
  }
}
