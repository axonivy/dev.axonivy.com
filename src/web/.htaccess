Options -Indexes +FollowSymLinks

DirectoryIndex index.html index.php

Order allow,deny
Allow from all

RewriteEngine On

ErrorDocument 404 /astro/404.html

# route doc resource links from; from 13.1 onwards
RewriteRule ^doc/((1[3-9]|[2-9]\d|\d\d\d)[^/]+)/openapi/(.+)$ /openapi/$1/$3 [L,R=302]
RewriteRule ^doc/((1[3-9]|[2-9]\d|\d\d\d)[^/]+)/[a-z][a-z]/openapi/(.+)$ /openapi/$1/$3 [L,R=302]
RewriteRule ^doc/((1[3-9]|[2-9]\d|\d\d\d)[^/]+)/public-api/(.+)$ /public-api/$1/$3 [L,R=302]
RewriteRule ^doc/((1[3-9]|[2-9]\d|\d\d\d)[^/]+)/[a-z][a-z]/public-api/(.+)$ /public-api/$1/$3 [L,R=302]
RewriteRule ^doc/((1[3-9]|[2-9]\d|\d\d\d)[^/]+)/engine-guide/reference/systemdb-schema/(.+)$ /systemdb/$1/$3 [L,R=302]
RewriteRule ^doc/((1[3-9]|[2-9]\d|\d\d\d)[^/]+)/[a-z][a-z]/engine-guide/reference/systemdb-schema/(.+)$ /systemdb/$1/$3 [L,R=302]

RewriteCond %{DOCUMENT_ROOT}/astro%{REQUEST_URI}/index.html -f
RewriteRule ^download/installation/([^/]+)/?$ /astro/download/installation/$1/index.html [L,QSA]

RewriteRule ^download/([^/]+)/(.+)$ /releases/ivy/$1/downloads/$2 [L]
RewriteRule ^doc/([^/]+)/([a-z][a-z])/(.+)$ /docs/$1/$2/$3 [L]

#RewriteRule ^doc$ /any-thing-to-redirect-to-php [L]
#RewriteRule ^doc/$ /docu [L]
#RewriteRule ^doc/([^/]+)$ /doc/$1/index.html [L]
#DirectorySlash off

RewriteCond %{DOCUMENT_ROOT}/astro/index.html -f
RewriteRule ^$ /astro/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/astro%{REQUEST_URI} -f
RewriteRule ^(.*)$ /astro/$1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/astro%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ /astro/$1/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]
